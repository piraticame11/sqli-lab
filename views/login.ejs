<%- include('partials/header') %>

<div class="max-w-md mx-auto px-4 py-12 sm:py-16">

  <div class="bg-white border border-gray-200 rounded-2xl shadow-lg p-8 relative">
    
    <div class="text-center mb-6">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-orange-50 text-[#ee4d2d] text-xl mb-3 shadow-sm border border-orange-100">
        <i class="fa-solid fa-store"></i>
      </div>
      <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Seller Centre Login</h1>
      <p class="text-xs text-gray-500 mt-1">
        Sign in to manage ShopNova listings, inventory & orders.
      </p>
    </div>

    <% if (locals.error) { %>
      <div class="mb-5 p-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs flex items-center space-x-2">
        <i class="fa-solid fa-circle-exclamation text-red-500"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/login" method="POST" class="space-y-4">
      <div>
        <label for="username" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">
          Username / Email
        </label>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
            <i class="fa-regular fa-user text-xs"></i>
          </div>
          <input 
            type="text" 
            id="username" 
            name="username" 
            required
            placeholder="e.g. admin or seller username" 
            value="<%= locals.attemptedUser || '' %>"
            class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-gray-50 border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#ee4d2d] focus:bg-white text-sm"
          >
        </div>
      </div>

      <div>
        <label for="password" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">
          Password
        </label>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
            <i class="fa-solid fa-lock text-xs"></i>
          </div>
          <input 
            type="password" 
            id="password" 
            name="password" 
            required
            placeholder="••••••••••••" 
            class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-gray-50 border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#ee4d2d] focus:bg-white text-sm"
          >
        </div>
      </div>

      <button 
        type="submit" 
        class="w-full py-3 px-4 rounded-xl bg-[#ee4d2d] hover:bg-[#d73211] text-white font-bold text-sm shadow-md shadow-orange-500/25 transition flex items-center justify-center space-x-2"
      >
        <span>Log In</span>
        <i class="fa-solid fa-arrow-right text-xs"></i>
      </button>
    </form>

    <div class="mt-5 pt-4 border-t border-gray-100 flex items-center justify-between text-xs text-gray-500">
      <a href="#" class="hover:text-[#ee4d2d] transition">Forgot Password?</a>
      <a href="#" class="hover:text-[#ee4d2d] transition">Seller Help Support</a>
    </div>
  </div>

</div>

<%- include('partials/footer') %>
