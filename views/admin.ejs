<%- include('partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <!-- Admin Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-center space-x-4">
      <div class="w-12 h-12 rounded-2xl bg-orange-100 text-[#ee4d2d] flex items-center justify-center text-2xl shadow-sm border border-orange-200">
        <i class="fa-solid fa-store"></i>
      </div>
      <div>
        <div class="flex items-center space-x-2">
          <h1 class="text-xl sm:text-2xl font-bold text-gray-900">Seller Centre Management</h1>
          <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-[10px] font-bold uppercase">
            ACTIVE SESSION
          </span>
        </div>
        <p class="text-xs text-gray-500 mt-0.5">
          Manager: <span class="font-bold text-gray-800"><%= currentUser.full_name %></span> (<%= currentUser.username %>) • Role: <span class="font-bold text-[#ee4d2d]"><%= currentUser.role %></span>
        </p>
      </div>
    </div>

    <a href="/logout" class="px-4 py-2 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-bold transition flex items-center space-x-1.5 self-start sm:self-auto">
      <i class="fa-solid fa-arrow-right-from-bracket"></i>
      <span>Log Out</span>
    </a>
  </div>

  <!-- Admin Dashboard Banner -->
  <div class="mb-6 p-6 rounded-2xl bg-gradient-to-r from-orange-500 to-[#ee4d2d] text-white shadow-md flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="inline-flex items-center space-x-1.5 bg-white/20 px-2.5 py-0.5 rounded-full text-xs font-bold mb-2">
        <i class="fa-solid fa-store"></i>
        <span>SHOPNOVA OFFICIAL SELLER CENTRE</span>
      </div>
      <h3 class="text-xl font-bold">Welcome to Seller Operations Console</h3>
      <p class="text-white/90 text-xs mt-1">
        Active Session: <span class="font-bold underline"><%= student.name %></span> • All store telemetry and administrative controls enabled.
      </p>
    </div>

    <div class="bg-white/10 backdrop-blur border border-white/30 p-4 rounded-xl text-center md:text-right">
      <span class="text-[10px] uppercase font-bold tracking-wider text-white/80 block mb-0.5">Admin Security Token:</span>
      <span class="text-white font-mono font-bold text-sm bg-black/20 px-3 py-1.5 rounded-lg select-all">
        <%= currentUser.api_key || 'FLAG{sh0p_4dm1n_byp4ss_2026}' %>
      </span>
    </div>
  </div>

  <!-- Shopee Analytics Cards -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm">
      <span class="text-xs text-gray-400 font-bold block uppercase mb-1">Today's Sales</span>
      <div class="text-2xl font-black text-[#ee4d2d]">$12,480.00</div>
      <div class="text-[11px] text-emerald-600 font-semibold mt-1">↑ +18.4% vs yesterday</div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm">
      <span class="text-xs text-gray-400 font-bold block uppercase mb-1">Active Catalog</span>
      <div class="text-2xl font-black text-gray-800"><%= totalProducts %> Products</div>
      <div class="text-[11px] text-gray-500 mt-1">100% In Stock</div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm">
      <span class="text-xs text-gray-400 font-bold block uppercase mb-1">Total Staff / Users</span>
      <div class="text-2xl font-black text-gray-800"><%= users.length %> Accounts</div>
      <div class="text-[11px] text-gray-500 mt-1">Store Permissions</div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm">
      <span class="text-xs text-gray-400 font-bold block uppercase mb-1">Store Rating</span>
      <div class="text-2xl font-black text-amber-500">4.9 / 5.0</div>
      <div class="text-[11px] text-gray-500 mt-1">1,240 Verified Reviews</div>
    </div>
  </div>

  <!-- Staff Credentials Directory (Dumping table for CTF verification) -->
  <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm">
    <div class="p-5 border-b border-gray-100 flex items-center justify-between">
      <div>
        <h3 class="font-bold text-gray-900 text-sm">Store Personnel & Customer Accounts</h3>
        <p class="text-xs text-gray-500 mt-0.5">Records stored inside the MySQL `users` table.</p>
      </div>
      <span class="px-2.5 py-1 rounded bg-gray-100 text-xs font-mono text-gray-600 font-semibold">
        Table: users
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs font-mono">
        <thead class="bg-gray-50 text-gray-600 border-b border-gray-200 uppercase text-[10px] tracking-wider">
          <tr>
            <th class="py-3 px-4">UID</th>
            <th class="py-3 px-4">Username</th>
            <th class="py-3 px-4">Role</th>
            <th class="py-3 px-4">Full Name</th>
            <th class="py-3 px-4">Email</th>
            <th class="py-3 px-4">Stored Password</th>
            <th class="py-3 px-4">API Key / Clearance Token</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-gray-800">
          <% users.forEach(u => { %>
            <tr class="hover:bg-orange-50/30 transition">
              <td class="py-3 px-4 font-bold text-[#ee4d2d]"><%= u.id %></td>
              <td class="py-3 px-4 font-bold text-gray-900"><%= u.username %></td>
              <td class="py-3 px-4">
                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase <%= u.role === 'admin' ? 'bg-orange-100 text-[#ee4d2d]' : 'bg-gray-100 text-gray-600' %>">
                  <%= u.role %>
                </span>
              </td>
              <td class="py-3 px-4"><%= u.full_name %></td>
              <td class="py-3 px-4 text-gray-500"><%= u.email %></td>
              <td class="py-3 px-4 font-bold text-orange-600 bg-orange-50/50 select-all"><%= u.password %></td>
              <td class="py-3 px-4 text-emerald-700 font-bold select-all"><%= u.api_key %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<%- include('partials/footer') %>
