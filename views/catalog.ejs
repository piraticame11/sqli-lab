<%- include('partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <!-- Breadcrumbs & Title -->
  <div class="flex items-center space-x-2 text-xs text-gray-500 mb-4">
    <a href="/" class="hover:text-[#ee4d2d]">Home</a>
    <span>/</span>
    <span class="text-gray-900 font-semibold">Product Catalog</span>
    <% if (locals.searchQuery) { %>
      <span>/</span>
      <span class="text-[#ee4d2d]">Search: "<%= searchQuery %>"</span>
    <% } %>
  </div>

  <!-- Search & Category Filter Bar (Clean White Theme) -->
  <div class="bg-white rounded-2xl p-4 sm:p-5 border border-gray-200 shadow-sm mb-6">
    <form action="/catalog" method="GET" class="flex flex-col md:flex-row items-center gap-3">
      
      <!-- Search Input -->
      <div class="flex-1 w-full relative">
        <input 
          type="text" 
          name="search" 
          placeholder="Search items, brands, or categories..." 
          value="<%= locals.searchQuery || '' %>"
          class="w-full bg-gray-50 border border-gray-300 rounded-xl pl-4 pr-10 py-2.5 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#ee4d2d] focus:bg-white transition"
        >
        <% if (locals.searchQuery) { %>
          <a href="/catalog" class="absolute right-3 top-3 text-gray-400 hover:text-gray-600 text-xs">
            <i class="fa-solid fa-xmark"></i>
          </a>
        <% } %>
      </div>

      <!-- Category Filter -->
      <div class="w-full md:w-56">
        <select 
          name="category" 
          class="w-full bg-gray-50 border border-gray-300 rounded-xl px-3 py-2.5 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-[#ee4d2d]"
        >
          <option value="">All Categories</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat.name %>" <%= (locals.selectedCategory === cat.name) ? 'selected' : '' %>>
              <%= cat.name %>
            </option>
          <% }) %>
        </select>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center space-x-2 w-full md:w-auto">
        <button 
          type="submit" 
          class="flex-1 md:flex-initial px-6 py-2.5 rounded-xl bg-[#ee4d2d] hover:bg-[#d73211] text-white font-semibold text-sm shadow-sm transition flex items-center justify-center space-x-1.5"
        >
          <i class="fa-solid fa-filter text-xs"></i>
          <span>Filter</span>
        </button>

        <!-- View Switcher -->
        <div class="flex items-center space-x-1 bg-gray-100 p-1 rounded-xl border border-gray-200">
          <button type="button" id="btnGrid" onclick="switchView('grid')" title="Grid View" class="p-2 rounded-lg bg-white text-[#ee4d2d] shadow-sm">
            <i class="fa-solid fa-grip text-xs"></i>
          </button>
          <button type="button" id="btnTable" onclick="switchView('table')" title="Data Table View" class="p-2 rounded-lg text-gray-500 hover:text-gray-800">
            <i class="fa-solid fa-table-list text-xs"></i>
          </button>
        </div>
      </div>

    </form>
  </div>

  <!-- Database SQL Error Message (for SQLi Testing / Screenshots) -->
  <% if (locals.sqlError) { %>
    <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm">
      <div class="flex items-center space-x-2 font-bold text-red-700 mb-1">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>Database Query Error (SQL Exception):</span>
      </div>
      <div class="font-mono text-xs bg-white p-3 rounded-lg border border-red-200 overflow-x-auto text-red-900 mt-2 select-all">
<%= sqlError %>
      </div>
    </div>
  <% } %>

  <!-- Catalog Results Header -->
  <div class="flex items-center justify-between mb-4">
    <div class="text-xs text-gray-500">
      Showing <span class="font-bold text-gray-800"><%= products ? products.length : 0 %></span> products found
    </div>
  </div>

  <!-- 1. Grid View (Shopee Style Cards) -->
  <div id="viewGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
    <% if (products && products.length > 0) { %>
      <% products.forEach(p => { %>
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-md hover:border-orange-300 transition flex flex-col group relative">
          
          <!-- Image -->
          <div class="relative h-44 bg-gray-100 overflow-hidden">
            <img 
              src="<%= p.image_url || 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=800&q=80' %>" 
              alt="<%= p.name %>" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              onerror="this.src='https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=800&q=80'"
            >
          </div>

          <!-- Content -->
          <div class="p-3 flex-1 flex flex-col justify-between">
            <div>
              <span class="text-[10px] text-gray-500 font-bold uppercase"><%= p.category || 'General' %></span>
              <h3 class="text-xs font-semibold text-gray-800 group-hover:text-[#ee4d2d] transition line-clamp-2 mt-1 leading-snug break-words">
                <a href="/product/<%= p.id %>">
                  <%= p.name %>
                </a>
              </h3>
              <% if (p.description) { %>
                <p class="text-[11px] text-gray-400 line-clamp-1 mt-1 font-mono break-words">
                  <%= p.description %>
                </p>
              <% } %>
            </div>

            <div class="mt-3 pt-2 border-t border-gray-100">
              <div class="text-base font-black text-[#ee4d2d]">
                $<%= !isNaN(Number(p.price)) ? Number(p.price).toFixed(2) : p.price %>
              </div>
              <div class="flex items-center justify-between text-[11px] text-gray-400 mt-1">
                <span>★ <%= p.rating || '4.8' %></span>
                <span><%= p.stock ? p.stock + ' in stock' : '' %></span>
              </div>
            </div>
          </div>

        </div>
      <% }) %>
    <% } else { %>
      <div class="col-span-full py-16 text-center bg-white rounded-2xl border border-gray-200">
        <i class="fa-solid fa-box-open text-4xl text-gray-300 mb-3"></i>
        <h3 class="text-base font-bold text-gray-800">No items found</h3>
        <p class="text-xs text-gray-500 mt-1">Try another search keyword or clear your filters.</p>
        <a href="/catalog" class="mt-3 inline-block px-4 py-2 rounded-lg bg-gray-100 text-gray-700 font-semibold text-xs hover:bg-gray-200">
          Reset Filter
        </a>
      </div>
    <% } %>
  </div>

  <!-- 2. Table View (Great for inspecting UNION Injection dumps) -->
  <div id="viewTable" class="hidden bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs font-mono">
        <thead class="bg-gray-50 text-gray-600 border-b border-gray-200 uppercase text-[10px] tracking-wider">
          <tr>
            <th class="py-3 px-4">#1 (ID)</th>
            <th class="py-3 px-4">#2 (Name)</th>
            <th class="py-3 px-4">#3 (Category)</th>
            <th class="py-3 px-4">#4 (SKU)</th>
            <th class="py-3 px-4">#5 (Price)</th>
            <th class="py-3 px-4">#6 (Stock)</th>
            <th class="py-3 px-4">#7 (Rating)</th>
            <th class="py-3 px-4">#8 (Image URL)</th>
            <th class="py-3 px-4">#9 (Description)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-gray-800">
          <% if (products && products.length > 0) { %>
            <% products.forEach(p => { %>
              <tr class="hover:bg-orange-50/40 transition">
                <td class="py-2.5 px-4 font-bold text-[#ee4d2d]"><%= p.id %></td>
                <td class="py-2.5 px-4 font-semibold text-gray-900 break-all"><%= p.name %></td>
                <td class="py-2.5 px-4 text-gray-600"><%= p.category %></td>
                <td class="py-2.5 px-4 text-gray-500"><%= p.sku %></td>
                <td class="py-2.5 px-4 font-bold text-gray-900"><%= p.price %></td>
                <td class="py-2.5 px-4 text-gray-600"><%= p.stock %></td>
                <td class="py-2.5 px-4 text-amber-500">★ <%= p.rating %></td>
                <td class="py-2.5 px-4 text-gray-400 max-w-xs truncate"><%= p.image_url %></td>
                <td class="py-2.5 px-4 font-bold text-orange-700 bg-orange-50/50 break-all"><%= p.description %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<script>
  function switchView(mode) {
    const grid = document.getElementById('viewGrid');
    const table = document.getElementById('viewTable');
    const btnGrid = document.getElementById('btnGrid');
    const btnTable = document.getElementById('btnTable');

    if (mode === 'table') {
      grid.classList.add('hidden');
      table.classList.remove('hidden');
      btnTable.className = 'p-2 rounded-lg bg-white text-[#ee4d2d] shadow-sm';
      btnGrid.className = 'p-2 rounded-lg text-gray-500 hover:text-gray-800';
    } else {
      table.classList.add('hidden');
      grid.classList.remove('hidden');
      btnGrid.className = 'p-2 rounded-lg bg-white text-[#ee4d2d] shadow-sm';
      btnTable.className = 'p-2 rounded-lg text-gray-500 hover:text-gray-800';
    }
  }
</script>

<%- include('partials/footer') %>
