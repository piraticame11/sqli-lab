<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50 text-gray-800">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.pageTitle ? pageTitle + ' | ' : '' %>ShopNova - Best Deals, Free Shipping & Trends</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/public/css/custom.css">
</head>
<body class="min-h-full flex flex-col bg-[#f5f5f5] text-gray-800 selection:bg-orange-500 selection:text-white">

  <!-- ============================================================== -->
  <!-- 1. TOP ANNOUNCEMENT & STUDENT IDENTITY BAR (FOR SCREENSHOTS)   -->
  <!-- ============================================================== -->
  <div class="student-name-ribbon py-2 px-4 shadow-sm text-xs font-medium">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
      
      <!-- Left: Friendly Shopee-style links -->
      <div class="flex items-center space-x-4">
        <a href="/admin" class="hover:underline flex items-center space-x-1 opacity-90 hover:opacity-100">
          <i class="fa-solid fa-store text-xs"></i>
          <span>Seller Centre</span>
        </a>
        <span class="opacity-50">|</span>
        <a href="/orders" class="hover:underline flex items-center space-x-1 opacity-90 hover:opacity-100">
          <i class="fa-solid fa-truck-fast text-xs"></i>
          <span>Track My Parcel</span>
        </a>
        <span class="opacity-50 hidden sm:inline">|</span>
        <span class="hidden sm:inline-flex items-center space-x-1 opacity-90">
          <i class="fa-solid fa-bell text-xs"></i>
          <span>Flash Sale Live! 50% Off</span>
        </span>
      </div>

      <!-- Right: PROMINENT STUDENT NAME (Indisputable proof for screenshot grading) -->
      <div class="flex items-center space-x-3">
        <div class="flex items-center space-x-1.5 bg-white/20 hover:bg-white/30 backdrop-blur px-3 py-0.5 rounded-full text-white font-bold transition">
          <i class="fa-solid fa-user-check text-xs"></i>
          <span>Shopper:</span>
          <span class="underline decoration-2"><%= locals.student ? student.name : 'Guest User' %></span>
        </div>
        <a href="/gate" title="Change your name" class="bg-white text-[#ee4d2d] px-2.5 py-0.5 rounded-full text-[11px] font-bold hover:bg-orange-50 transition shadow-sm">
          Edit Name
        </a>
      </div>

    </div>
  </div>

  <!-- ============================================================== -->
  <!-- 2. SCREENSHOT CORNER WATERMARK (VISIBLE ON ALL SCREENS)         -->
  <!-- ============================================================== -->
  <div class="screenshot-watermark-overlay flex items-center space-x-2 text-xs border border-orange-200">
    <div class="w-2 h-2 rounded-full bg-[#ee4d2d] animate-pulse"></div>
    <span class="text-gray-900 font-bold"><%= locals.student ? student.name : 'Student' %></span>
    <span class="text-gray-300">|</span>
    <span id="liveClock" class="text-gray-500 font-mono text-[11px]">--:--:--</span>
  </div>

  <script>
    function updateLiveClock() {
      const now = new Date();
      const clockEl = document.getElementById('liveClock');
      if (clockEl) {
        clockEl.textContent = now.toLocaleTimeString();
      }
    }
    setInterval(updateLiveClock, 1000);
    updateLiveClock();
  </script>

  <!-- ============================================================== -->
  <!-- 3. MAIN WHITE THEME E-COMMERCE NAVBAR                         -->
  <!-- ============================================================== -->
  <header class="bg-white border-b border-gray-200 sticky top-[37px] z-40 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20 gap-4 sm:gap-8">
        
        <!-- Logo -->
        <a href="/" class="flex items-center space-x-2.5 flex-shrink-0 group">
          <div class="w-11 h-11 rounded-2xl bg-[#ee4d2d] flex items-center justify-center text-white text-xl shadow-md shadow-orange-500/25 group-hover:scale-105 transition-transform">
            <i class="fa-solid fa-bag-shopping"></i>
          </div>
          <div>
            <span class="text-2xl font-black tracking-tight text-[#ee4d2d]">Shop<span class="text-gray-900">Nova</span></span>
            <span class="block text-[10px] uppercase tracking-widest text-gray-400 font-bold -mt-1">Mall & Mart</span>
          </div>
        </a>

        <!-- Shopee-Style Large Search Bar (Connected to Vulnerable Catalog Search) -->
        <div class="flex-1 max-w-2xl">
          <form action="/catalog" method="GET" class="relative flex items-center">
            <div class="relative w-full">
              <input 
                type="text" 
                name="search" 
                placeholder="Search products, brands, or deals..." 
                value="<%= locals.searchQuery || '' %>"
                class="w-full bg-gray-50 border-2 border-[#ee4d2d] rounded-lg pl-4 pr-24 py-2.5 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:bg-white transition"
              >
              <button 
                type="submit" 
                class="absolute right-1 top-1 bottom-1 px-5 bg-[#ee4d2d] hover:bg-[#d73211] text-white rounded-md text-sm font-semibold flex items-center justify-center transition shadow-sm"
              >
                <i class="fa-solid fa-magnifying-glass mr-1.5 text-xs"></i>
                <span class="hidden sm:inline">Search</span>
              </button>
            </div>
          </form>

          <!-- Hot Search Keywords -->
          <div class="hidden md:flex items-center space-x-3 text-[11px] text-gray-500 mt-1 pl-1">
            <span>Trending:</span>
            <a href="/catalog?search=Headphones" class="hover:text-[#ee4d2d]">Wireless Headphones</a>
            <a href="/catalog?search=Watch" class="hover:text-[#ee4d2d]">Smart Watch</a>
            <a href="/catalog?search=Keyboard" class="hover:text-[#ee4d2d]">Mechanical Keyboard</a>
            <a href="/catalog?search=Coffee" class="hover:text-[#ee4d2d]">Espresso Machine</a>
          </div>
        </div>

        <!-- Right Action Items (Cart & Account) -->
        <div class="flex items-center space-x-4 flex-shrink-0">
          
          <!-- Shopping Cart Icon -->
          <a href="/catalog" class="relative p-2 text-gray-700 hover:text-[#ee4d2d] transition" title="Shopping Cart">
            <i class="fa-solid fa-cart-shopping text-2xl"></i>
            <span class="absolute top-0 right-0 w-5 h-5 rounded-full bg-[#ee4d2d] text-white text-[11px] font-bold flex items-center justify-center shadow-sm">
              3
            </span>
          </a>

          <!-- User Account / Seller Login -->
          <% if (locals.currentUser) { %>
            <div class="flex items-center space-x-2 pl-3 border-l border-gray-200">
              <a href="/admin" class="flex items-center space-x-2 bg-orange-50 border border-orange-200 text-[#ee4d2d] px-3 py-1.5 rounded-lg text-sm font-semibold hover:bg-orange-100 transition">
                <i class="fa-solid fa-user-shield text-xs"></i>
                <span><%= currentUser.full_name %> (<%= currentUser.role %>)</span>
              </a>
              <a href="/logout" title="Log Out" class="text-gray-400 hover:text-red-500 p-2 text-sm">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
              </a>
            </div>
          <% } else { %>
            <a href="/login" class="flex items-center space-x-1.5 text-gray-700 hover:text-[#ee4d2d] font-semibold text-sm px-3 py-1.5 rounded-lg hover:bg-gray-100 transition">
              <i class="fa-regular fa-circle-user text-lg text-gray-500"></i>
              <span class="hidden sm:inline">Seller / Staff</span>
            </a>
          <% } %>

        </div>

      </div>
    </div>

    <!-- Category Sub-nav Bar -->
    <div class="border-t border-gray-100 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center space-x-6 h-10 overflow-x-auto text-xs font-semibold text-gray-600">
          <a href="/catalog" class="hover:text-[#ee4d2d] flex items-center space-x-1 whitespace-nowrap <%= locals.activePage === 'catalog' ? 'text-[#ee4d2d]' : '' %>">
            <i class="fa-solid fa-bars text-xs"></i>
            <span>All Categories</span>
          </a>
          <a href="/catalog?category=Electronics" class="hover:text-[#ee4d2d] whitespace-nowrap">Electronics & Gadgets</a>
          <a href="/catalog?category=Fashion" class="hover:text-[#ee4d2d] whitespace-nowrap">Fashion & Apparel</a>
          <a href="/catalog?category=Home%20%26%20Living" class="hover:text-[#ee4d2d] whitespace-nowrap">Home & Living</a>
          <a href="/catalog?category=Appliances" class="hover:text-[#ee4d2d] whitespace-nowrap">Smart Appliances</a>
          <a href="/orders" class="hover:text-[#ee4d2d] whitespace-nowrap text-orange-600 font-bold ml-auto flex items-center space-x-1">
            <i class="fa-solid fa-truck-fast"></i>
            <span>Track Parcel</span>
          </a>
        </div>
      </div>
    </div>
  </header>
