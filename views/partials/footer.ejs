            <div class="text-gray-900 font-bold text-sm"><%= locals.student ? student.name : 'Guest' %></div>
            <div class="pt-1 border-t border-orange-200/60 flex items-center justify-between text-[11px]">
              <span class="text-emerald-600 font-medium">● Store Online</span>
              <a href="/gate" class="text-[#ee4d2d] hover:underline font-semibold">Change Name</a>
            </div>
          </div>
