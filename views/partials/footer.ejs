          <h4 class="text-xs font-bold uppercase tracking-wider text-gray-900 mb-3">About ShopNova</h4>
          <ul class="space-y-2 text-xs">
            <li><a href="#" class="hover:text-[#ee4d2d] transition">About Us</a></li>
            <li><a href="#" class="hover:text-[#ee4d2d] transition">Careers</a></li>
            <li><a href="#" class="hover:text-[#ee4d2d] transition">ShopNova Mall</a></li>
            <li><a href="#" class="hover:text-[#ee4d2d] transition">Flash Deals</a></li>
            <li><a href="/admin" class="hover:text-[#ee4d2d] transition">Seller Centre</a></li>
          </ul>
        </div>

        <!-- Payment & Logistics -->
        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-gray-900 mb-3">Payment & Delivery</h4>
          <div class="flex flex-wrap gap-2 text-gray-600 text-xl mb-3">
            <span class="w-10 h-7 border border-gray-200 rounded flex items-center justify-center text-xs font-bold text-blue-600 bg-gray-50">VISA</span>
            <span class="w-10 h-7 border border-gray-200 rounded flex items-center justify-center text-xs font-bold text-red-500 bg-gray-50">MC</span>
            <span class="w-10 h-7 border border-gray-200 rounded flex items-center justify-center text-[10px] font-bold text-orange-600 bg-gray-50">PAY</span>
            <span class="w-10 h-7 border border-gray-200 rounded flex items-center justify-center text-[10px] font-bold text-green-600 bg-gray-50">COD</span>
          </div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-gray-900 mb-2">Delivery Partners</h4>
          <div class="text-xs text-gray-500">
            J&T Express • Ninja Van • SpeedPost • ShopNova Xpress
          </div>
        </div>

        <!-- Student Session Info (Clean) -->
