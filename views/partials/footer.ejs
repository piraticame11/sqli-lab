            <li><a href="#" class="hover:text-[#ee4d2d] transition">Shopee Guarantee</a></li>
            <li><a href="#" class="hover:text-[#ee4d2d] transition">Free Shipping Policy</a></li>
            <li><a href="#" class="hover:text-[#ee4d2d] transition">Return & Refund</a></li>
            <li><a href="#" class="hover:text-[#ee4d2d] transition">Help Centre</a></li>
          </ul>
        </div>

        <!-- About ShopNova -->
