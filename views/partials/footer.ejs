  <!-- ============================================================== -->
  <!-- 4. DEVELOPER QUERY INSPECTOR (SUBTLE & CLEAN FOR LAB GRADING)  -->
  <!-- ============================================================== -->
  <% if (locals.lastQuery || locals.sqlError) { %>
    <aside class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-10 mb-6 w-full">
      <div class="rounded-xl border border-gray-200 bg-white overflow-hidden shadow-sm">
        <div class="px-4 py-2.5 bg-gray-50 border-b border-gray-200 flex items-center justify-between text-xs">
          <div class="flex items-center space-x-2 text-gray-700">
            <span class="w-2 h-2 rounded-full bg-orange-500"></span>
            <span class="font-bold text-gray-800">Server Query Output</span>
            <span class="text-gray-400">• (Database inspection feed for screenshots)</span>
          </div>
          <button type="button" onclick="document.getElementById('debugDetails').classList.toggle('hidden')" class="text-xs text-[#ee4d2d] hover:underline font-semibold">
            Toggle Query
          </button>
        </div>
        
        <div id="debugDetails" class="p-4 space-y-3 font-mono text-xs">
          <% if (locals.lastQuery) { %>
            <div>
              <span class="text-gray-500 uppercase text-[10px] font-bold tracking-wider block mb-1">Executed SQL:</span>
              <div class="p-3 bg-gray-50 rounded-lg border border-gray-200 text-blue-700 break-all select-all leading-relaxed">
                <%= lastQuery %>
              </div>
            </div>
          <% } %>

          <% if (locals.sqlError) { %>
            <div>
              <span class="text-red-600 uppercase text-[10px] font-bold tracking-wider block mb-1">Database Error:</span>
              <div class="p-3 bg-red-50 rounded-lg border border-red-200 text-red-600 break-all">
                <i class="fa-solid fa-triangle-exclamation mr-1"></i> <%= sqlError %>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </aside>
  <% } %>

