        <div class="mt-2 sm:mt-0 flex items-center space-x-4">
          <a href="/lab-guide" class="text-gray-400 hover:text-gray-600 underline">Instructor Assignment Guidelines</a>
          <a href="#" class="hover:text-gray-700">Privacy Policy</a>
