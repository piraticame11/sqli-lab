<%- include('partials/header') %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <!-- Breadcrumbs -->
  <div class="flex items-center space-x-2 text-xs text-gray-500 mb-6">
    <a href="/" class="hover:text-[#ee4d2d]">Home</a>
    <span>/</span>
    <a href="/catalog" class="hover:text-[#ee4d2d]">Catalog</a>
    <span>/</span>
    <span class="text-gray-800 font-semibold truncate max-w-xs"><%= product ? product.name : 'Item' %></span>
  </div>

  <% if (locals.sqlError) { %>
    <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm">
      <div class="flex items-center space-x-2 font-bold text-red-700 mb-1">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>Product Lookup Error (SQL Exception):</span>
      </div>
      <div class="font-mono text-xs bg-white p-3 rounded-lg border border-red-200 overflow-x-auto text-red-900 mt-2 select-all">
<%= sqlError %>
      </div>
    </div>
  <% } %>

  <% if (product) { %>
    <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm grid grid-cols-1 md:grid-cols-2 p-6 gap-8">
      
      <!-- Product Image -->
      <div class="rounded-xl overflow-hidden bg-gray-100 flex items-center justify-center p-4 border border-gray-100">
        <img 
          src="<%= product.image_url || 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=800&q=80' %>" 
          alt="<%= product.name %>" 
          class="max-h-96 w-full object-cover rounded-lg shadow-sm"
          onerror="this.src='https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=800&q=80'"
        >
      </div>

      <!-- Product Info -->
      <div class="flex flex-col justify-between">
        <div>
          <!-- Badges -->
          <div class="flex items-center space-x-2 mb-2">
            <span class="bg-[#ee4d2d] text-white text-[11px] font-bold px-2 py-0.5 rounded">Shopee Preferred</span>
            <span class="text-xs text-gray-400 font-mono">SKU: <%= product.sku || 'N/A' %></span>
          </div>

          <h1 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight mb-2 break-words">
            <%= product.name %>
          </h1>

          <!-- Rating & Sales -->
          <div class="flex items-center space-x-4 text-xs pb-4 border-b border-gray-100">
            <span class="text-orange-500 font-bold underline"><%= product.rating || '4.8' %> ★★★★★</span>
            <span class="text-gray-300">|</span>
            <span class="text-gray-600 font-medium">854 Ratings</span>
            <span class="text-gray-300">|</span>
            <span class="text-gray-600 font-medium"><%= product.sales_count || '2.1k' %> Sold</span>
          </div>

          <!-- Price Box (Shopee Style) -->
          <div class="my-5 p-4 rounded-xl bg-orange-50/70 border border-orange-100 flex items-baseline space-x-3">
            <span class="text-3xl font-black text-[#ee4d2d]">
              $<%= !isNaN(Number(product.price)) ? Number(product.price).toFixed(2) : product.price %>
            </span>
            <span class="text-xs font-bold text-[#ee4d2d] bg-white border border-orange-200 px-2 py-0.5 rounded">
              25% OFF
            </span>
          </div>

          <!-- Description -->
          <div class="space-y-2">
            <h4 class="text-xs font-bold uppercase tracking-wider text-gray-700">Product Overview</h4>
            <p class="text-xs text-gray-600 leading-relaxed bg-gray-50 p-4 rounded-xl border border-gray-200/70 break-words font-mono">
              <%= product.description %>
            </p>
          </div>

          <!-- Stock & Shipping Details -->
          <div class="mt-4 grid grid-cols-2 gap-3 text-xs">
            <div class="p-3 rounded-lg bg-gray-50 border border-gray-200">
              <span class="text-gray-400 block text-[10px] uppercase font-bold">Availability</span>
              <span class="text-gray-800 font-bold"><%= product.stock %> units in stock</span>
            </div>
            <div class="p-3 rounded-lg bg-gray-50 border border-gray-200">
              <span class="text-gray-400 block text-[10px] uppercase font-bold">Shipping</span>
              <span class="text-emerald-700 font-bold">🚚 Free Delivery Available</span>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="mt-6 pt-4 border-t border-gray-100 flex items-center space-x-3">
          <button 
            type="button" 
            onclick="alert('Item added to your cart!')" 
            class="flex-1 py-3 px-4 rounded-xl bg-orange-100 hover:bg-orange-200 text-[#ee4d2d] font-bold text-xs flex items-center justify-center space-x-2 transition border border-orange-200"
          >
            <i class="fa-solid fa-cart-plus"></i>
            <span>Add to Cart</span>
          </button>
          
          <button 
            type="button" 
            onclick="alert('Redirecting to checkout demo.')" 
            class="flex-1 py-3 px-4 rounded-xl bg-[#ee4d2d] hover:bg-[#d73211] text-white font-bold text-xs flex items-center justify-center space-x-2 transition shadow-md shadow-orange-500/20"
          >
            <span>Buy Now</span>
          </button>
        </div>

      </div>

    </div>
  <% } else { %>
    <div class="py-16 text-center bg-white rounded-2xl border border-gray-200">
      <i class="fa-solid fa-triangle-exclamation text-4xl text-amber-500 mb-3"></i>
      <h3 class="text-base font-bold text-gray-800">Product Not Found</h3>
      <p class="text-xs text-gray-500 mt-1">Requested Product ID: <%= requestedId %></p>
      <a href="/catalog" class="mt-3 inline-block px-4 py-2 rounded-lg bg-[#ee4d2d] text-white text-xs font-semibold">
        Back to Catalog
      </a>
    </div>
  <% } %>

</div>

<%- include('partials/footer') %>
