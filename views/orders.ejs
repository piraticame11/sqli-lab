<%- include('partials/header') %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <div class="text-center max-w-xl mx-auto mb-8">
    <div class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full bg-orange-100 text-[#ee4d2d] text-xs font-bold mb-2">
      <i class="fa-solid fa-truck-fast"></i>
      <span>SHOPNOVA EXPRESS LOGISTICS</span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">Track Your Delivery Parcel</h1>
    <p class="text-gray-500 text-xs mt-1.5">
      Enter your Shopee/ShopNova parcel tracking number to check real-time courier status and delivery updates.
    </p>
  </div>

  <!-- Search Card -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 shadow-sm mb-6">
    <form action="/orders/track" method="GET" class="space-y-4">
      <div>
        <label for="trackingCode" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">
          Tracking / Order Number
        </label>
        <div class="relative">
          <input 
            type="text" 
            id="trackingCode" 
            name="code" 
            required
            placeholder="e.g. SN-99214-SG" 
            value="<%= locals.searchedCode || '' %>"
            class="w-full pl-4 pr-12 py-3 rounded-xl bg-gray-50 border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#ee4d2d] focus:bg-white text-sm font-medium transition"
          >
          <button 
            type="submit" 
            class="absolute right-2 top-2 bottom-2 px-5 bg-[#ee4d2d] hover:bg-[#d73211] text-white rounded-lg text-xs font-bold flex items-center justify-center transition shadow-sm"
          >
            Track
          </button>
        </div>
      </div>

      <div class="flex items-center justify-between text-xs text-gray-500 pt-1">
        <span>Format: <span class="font-mono text-gray-600">SN-XXXXX-XX</span></span>
        <span class="text-gray-400">ShopNova Xpress Logistics</span>
      </div>
    </form>
  </div>

  <!-- Database Error Message -->
  <% if (locals.sqlError) { %>
    <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm">
      <div class="flex items-center space-x-2 font-bold text-red-700 mb-1">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>Tracking Lookup Error (SQL Exception):</span>
      </div>
      <div class="font-mono text-xs bg-white p-3 rounded-lg border border-red-200 overflow-x-auto text-red-900 mt-2 select-all">
<%= sqlError %>
      </div>
    </div>
  <% } %>

  <!-- Orders Results -->
  <% if (locals.orders && orders.length > 0) { %>
    <div class="space-y-4">
      <div class="text-xs font-bold text-gray-600 px-1">
        Found <%= orders.length %> parcel shipment(s)
      </div>

      <% orders.forEach(order => { %>
        <div class="bg-white border border-gray-200 rounded-2xl p-5 shadow-sm">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-gray-100 gap-2">
            <div>
              <span class="text-[10px] text-gray-400 uppercase font-bold">Parcel Number</span>
              <h3 class="text-base font-bold font-mono text-[#ee4d2d]"><%= order.tracking_number %></h3>
            </div>
            <span class="px-3 py-1 rounded-full text-xs font-bold <%= order.status === 'Delivered' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-orange-50 text-orange-700 border border-orange-200' %> self-start sm:self-auto">
              <%= order.status %>
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 py-3 text-xs">
            <div>
              <span class="text-gray-400 text-[10px] uppercase font-bold block mb-0.5">Recipient</span>
              <span class="text-gray-900 font-bold"><%= order.customer_name %></span>
              <div class="text-gray-500 text-[11px]"><%= order.customer_email %></div>
            </div>

            <div>
              <span class="text-gray-400 text-[10px] uppercase font-bold block mb-0.5">Shipping Address</span>
              <span class="text-gray-700 font-medium"><%= order.destination %></span>
            </div>

            <div>
              <span class="text-gray-400 text-[10px] uppercase font-bold block mb-0.5">Order Total</span>
              <span class="text-[#ee4d2d] font-black text-sm">
                $<%= !isNaN(Number(order.total_amount)) ? Number(order.total_amount).toFixed(2) : order.total_amount %>
              </span>
            </div>
          </div>

          <% if (order.notes) { %>
            <div class="mt-2 pt-2 border-t border-gray-100 bg-gray-50 p-3 rounded-xl text-xs font-mono">
              <span class="text-gray-500 font-bold block mb-1 text-[11px]">Courier Delivery Remarks:</span>
              <div class="text-gray-800 break-words select-all">
                <%= order.notes %>
              </div>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } else if (locals.searchedCode && !locals.sqlError) { %>
    <div class="py-12 text-center bg-white border border-gray-200 rounded-2xl">
      <i class="fa-solid fa-box-archive text-4xl text-gray-300 mb-2"></i>
      <h3 class="text-sm font-bold text-gray-800">No parcel found</h3>
      <p class="text-xs text-gray-500 mt-0.5">Check your tracking reference and try again.</p>
    </div>
  <% } %>

</div>

<%- include('partials/footer') %>
